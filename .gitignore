# =========================================================
# Terraform
# =========================================================

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.tfplan.json

# Terraform variable files
*.tfvars
*.tfvars.json

# Exception: keep example variable files
!*.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file
# IMPORTANT: Keep this file in Git for reproducible provider versions
#.terraform.lock.hcl


